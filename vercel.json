{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs"
    },
    "backend": {
      "root": "backend",
      "entrypoint": "index.py"
    }
  },
  "rewrites": [
    {
      "source": "/characters(.*)",
      "destination": { "type": "service", "service": "backend" }
    },
    {
      "source": "/storage(.*)",
      "destination": { "type": "service", "service": "backend" }
    },
    {
      "source": "/health",
      "destination": { "type": "service", "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "type": "service", "service": "frontend" }
    }
  ]
}
